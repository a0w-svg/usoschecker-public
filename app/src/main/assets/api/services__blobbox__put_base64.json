{
  "name": "services/blobbox/put_base64",
  "short_name": "put_base64",
  "description": "\t\n\t<p>Put a blob into the database. Use base64 encoding to pass the binary\n\tdata.</p>\n\t\n\t<p>Please include an Access Token if you have one\n\t(<a href=\"#why_use_access_tokens\">why?</a>)</p>\n",
  "brief_description": "Put a blob into the database, using base64 encoding.",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/blobbox/#put_base64",
  "auth_options": {
    "consumer": "required",
    "token": "optional",
    "administrative_only": true,
    "ssl_required": false,
    "scopes": []
  },
  "arguments": [
    {
      "name": "data",
      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\t\n\t<p>Base64-encoded data to be stored (no more than 1 MB).</p>\n\t\n\t<p>This method is not recommended. It is more efficient to\n\tuse the <a href=\"https://usosapps.vistula.edu.pl/developers/api/services/blobbox/#put\">put</a> method (which also\nallows you to store bigger blobs than 1MB!).</p>\n"
    },
    {
      "name": "read_access",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "consumer",
      "description": "\t\n\tSame as in the <a href=\"https://usosapps.vistula.edu.pl/developers/api/services/blobbox/#put_text\">put_text</a> method.\n"
    },
    {
      "name": "min_age",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
