      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\tID of the parent node for our new node. The type of this node must be root or folder."
    },
    {
      "name": "name_pl",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\tName of the node (in polish)."
    },
    {
      "name": "name_en",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\tName of the node (in english)."
    },
    {
      "name": "order",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\tinteger - order (see <a href=\"https://usosapps.vistula.edu.pl/developers/api/services/crstests/#ordering\">ordering</a>)"
    },
    {
      "name": "points_min",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\tMinimal number of points available for this task. Default value = 0.0"
    },
    {
      "name": "points_max",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\tMaximal number of points available for this task. Default value = 10.0"
    },
    {
