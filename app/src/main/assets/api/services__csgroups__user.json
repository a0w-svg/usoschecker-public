    },
    {
      "name": "format",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "json",
      "description": "\n<p>Format in which to return values. See <a\n            href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/'>\n            supported output formats</a>.</p>"
    },
    {
      "name": "callback",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "",
      "description": "\n<p>Required only if you've chosen <b>jsonp</b> as a return format.</p>"
    }
  ],
  "returns": "\n\n        <p>A list of dictionaries describing custom groups\n        (as returned by <a href='https://usosapps.vistula.edu.pl/developers/api/services/csgroups/#custom_group'>custom_group</a> method).</p>\n    ",
  "errors": "",
  "result_fields": [],
  "beta": true,
  "deprecated": null,
  "is_internal": false
