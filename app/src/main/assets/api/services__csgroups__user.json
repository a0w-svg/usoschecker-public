{
  "name": "services/csgroups/user",
  "short_name": "user",
  "description": "<p>\nGet user's custom groups.</p>",
  "brief_description": "\nGet user's custom groups.",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/csgroups/#user",
  "auth_options": {
    "administrative_only": false,
    "token": "required",
    "consumer": "required",
    "ssl_required": true,
    "scopes": [
      "studies",
      "mailclient"
    ]
  },
  "arguments": [
    {
      "name": "fields",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "id|name",
