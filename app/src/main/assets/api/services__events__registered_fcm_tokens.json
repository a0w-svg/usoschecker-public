      "name": "instance_id",
      "description": "\nID of the FCM instance",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "instance_name",
      "description": "\nUser-readable name of the instance",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "fcm_registration_token",
