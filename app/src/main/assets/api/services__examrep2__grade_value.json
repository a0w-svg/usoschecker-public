{
  "name": "services/examrep2/grade_value",
  "short_name": "grade_value",
  "description": "<p>\nGet information about grade value</p>",
  "brief_description": "\nGet information about grade value",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/examrep2/#grade_value",
  "auth_options": {
    "administrative_only": false,
    "token": "ignored",
    "consumer": "ignored",
    "ssl_required": true,
    "scopes": []
  },
  "arguments": [
