{
  "name": "services/geo/rooms",
  "short_name": "rooms",
  "description": "\n\n        <p>Get information on multiple rooms.</p>\n\n        <p>This method is similar to the <a href='https://usosapps.vistula.edu.pl/developers/api/services/geo/#room'>room</a>\n        method, but it works with multiple rooms.</p>\n    ",
  "brief_description": "\nGet information on multiple rooms.",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/geo/#rooms",
  "auth_options": {
    "administrative_only": false,
    "token": "optional",
    "consumer": "optional",
    "ssl_required": false,
    "scopes": []
  },
  "arguments": [
    {
      "name": "room_ids",
      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\nPipe-separated list of room IDs."
    },
    {
      "name": "fields",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "id|number|building_id|building_name",
      "description": "\n\n            <p><a href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/#fields'>\n            Selector</a> of result fields you are interested in. \n    \n    The selector  may contain any subset of fields, which are\n    described in the <b>returns</b> section\n    of <a href='https://usosapps.vistula.edu.pl/developers/api/services/geo/#room'>room</a> method.\n</p>\n        "
    },
    {
      "name": "format",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "json",
      "description": "\n<p>Format in which to return values. See <a\n            href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/'>\n            supported output formats</a>.</p>"
    },
    {
      "name": "callback",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "",
      "description": "\n<p>Required only if you've chosen <b>jsonp</b> as a return format.</p>"
    }
  ],
  "returns": "\n\n        <p>A dictionary: your <b>room_ids</b> will be mapped to dictionary's\n        keys, and each value will contain the description of a room, as defined\n        in the <a href='https://usosapps.vistula.edu.pl/developers/api/services/geo/#room'>room</a> method.</p>\n    ",
