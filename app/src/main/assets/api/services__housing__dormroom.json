{
  "name": "services/housing/dormroom",
  "short_name": "dormroom",
  "description": "\n\n        <p>Get information on a single dormitory room.</p>\n\n        <p>Note, that you'll get an error if your user doesn't have proper\n        permissions to view this room.</p>\n    ",
  "brief_description": "\nGet information on a single dormitory room.",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormroom",
  "auth_options": {
    "administrative_only": false,
    "token": "required",
    "consumer": "required",
    "ssl_required": true,
    "scopes": [
      "dorm_admin"
    ]
  },
  "arguments": [
    {
      "name": "dormroom_id",
      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\n\n            ID of a dormitory room.\n        "
    },
    {
      "name": "fields",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "id",
      "description": "\n\n            <p><a href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/#fields'>\n            Selector</a> of result fields you are interested in. \n    \n    The selector  may contain any subset of fields, which are\n    described in the <b>returns</b> section.\n</p>\n        "
    },
    {
      "name": "format",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "json",
      "description": "\n<p>Format in which to return values. See <a\n            href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/'>\n            supported output formats</a>.</p>"
    },
    {
      "name": "callback",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "",
      "description": "\n<p>Required only if you've chosen <b>jsonp</b> as a return format.</p>"
    }
  ],
  "returns": "\n\n                    <p>A dictionary of selected fields and their values.</p>\n                    <p>Available fields:\n                \n    \n    \n    <ul>\n        \n        <li >\n            \n                <p><b>id</b> -\n                    ID of this dormitory room;</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>number</b> -\n                    room number (string, not an integer!);</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>type</b> - an object describing the room type.</p>\n\n                \n\n                <p>As described in the\n                <a href='https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormroom_type'>dormroom_type</a> method\n                (subfields allowed).\n            \n\n                \n                    <p>This field references objects returned by\n                    <a href='https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormroom_type'>dormroom_type</a> method. See its <b>returns</b> section\n                    for possible subfields.</p>\n                \n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>dormitory</b> - a parent dormitory of this room.</p>\n\n                \n\n                <p>As described in the\n                <a href='https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormitory'>dormitory</a> method\n                (subfields allowed).\n            \n\n                \n                    <p>This field references objects returned by\n                    <a href='https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormitory'>dormitory</a> method. See its <b>returns</b> section\n                    for possible subfields.</p>\n                \n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>capacity</b> -\n                    integer, a maximum number of occupants.</p>\n            \n            \n        </li>\n        \n    </ul>\n</p>",
  "errors": "",
  "result_fields": [
    {
      "name": "id",
      "description": "\nID of this dormitory room",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "number",
      "description": "\nroom number (string, not an integer!)",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "type",
      "description": "\n\n                <p>As described in the\n                <a href='https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormroom_type'>dormroom_type</a> method\n                (subfields allowed).\n            ",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "dormitory",
      "description": "\n\n                <p>As described in the\n                <a href='https://usosapps.vistula.edu.pl/developers/api/services/housing/#dormitory'>dormitory</a> method\n                (subfields allowed).\n            ",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "capacity",
      "description": "\ninteger, a maximum number of occupants",
      "is_primary": true,
      "is_secondary": false
    }
  ],
