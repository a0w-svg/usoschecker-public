  ],
  "returns": "\n\n                    <p>A dictionary of selected fields and their values.</p>\n                    <p>Available fields:\n                \n    \n    \n    <ul>\n        \n        <li >\n            \n                <p><b>id</b> -\n                    attachment ID;</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>filename</b> -\n                    filename of the attachment;</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>size</b> -\n                    size of the attachment (in bytes);</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>description</b> -\n                    description of the attachment;</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>url</b> -\n                    URL address of the attachment.</p>\n            \n            \n        </li>\n        \n    </ul>\n</p>",
