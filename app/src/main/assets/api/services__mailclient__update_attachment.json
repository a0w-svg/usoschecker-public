{
  "name": "services/mailclient/update_attachment",
  "short_name": "update_attachment",
  "description": "\n\n        <p>Update information on a given attachment. Note that only description can be changed.\n        If you want to update other fields, you have to delete the old attachment and upload the\n        new one.</p>\n\n        <p>This method works only with messages with status <b>draft</b>.</p>\n    ",
  "brief_description": "\nUpdate an attachment.",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/mailclient/#update_attachment",
  "auth_options": {
    "administrative_only": false,
    "token": "required",
    "consumer": "required",
    "ssl_required": false,
    "scopes": [
      "mailclient"
    ]
  },
  "arguments": [
    {
      "name": "attachment_id",
      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\n<p>Attachment ID.</p>"
    },
    {
      "name": "description",
      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\n<p>Attachment description. No more than 200 characters.</p>"
    },
    {
      "name": "format",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "json",
      "description": "\n<p>Format in which to return values. See <a\n            href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/'>\n            supported output formats</a>.</p>"
    },
    {
      "name": "callback",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "",
      "description": "\n<p>Required only if you've chosen <b>jsonp</b> as a return format.</p>"
    }
  ],
  "returns": "\n\n    An empty dictionary returned if the method has been executed successfully.\n    Some keys may be added in the future.\n",
  "errors": "\n\n    \n    \n    <ul>\n        \n        <li>\n            \n                <p><b>object_invalid</b> - message is in invalid state.</p>\n\n                \n\n                \n                    <p>Possible reasons:</p>\n                    <ul>\n                        \n                        <li>\n                            \n                                <p><b>draft_required</b> -\n                                message is not a draft.</p>\n                            \n                        </li>\n                        \n                    </ul>\n                \n            \n        </li>\n        \n        <li>\n            \n                <p><b>object_not_found</b> -\n                attachment could not be found; <b>param_name</b> is equal to <b>attachment_id</b>.</p>\n            \n        </li>\n        \n    </ul>\n",
  "result_fields": [],
  "beta": false,
  "deprecated": null,
  "is_internal": false
}
