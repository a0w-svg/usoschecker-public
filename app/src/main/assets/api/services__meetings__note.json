{
  "name": "services/meetings/note",
  "short_name": "note",
  "description": "\n\n        Get meeting note instance, that is both public and private meeting note. This method is meant for staff, because\n        it only returns notes authored by access token issuer.\n    ",
  "brief_description": "\nGet meeting note instance.",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/meetings/#note",
  "auth_options": {
    "administrative_only": false,
    "token": "required",
    "consumer": "required",
    "ssl_required": false,
    "scopes": []
  },
  "arguments": [
