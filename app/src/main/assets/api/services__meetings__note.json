      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "private_note",
      "description": "\nstring, private note",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "public_note",
      "description": "\nstring, public note",
      "is_primary": true,
      "is_secondary": false
    }
