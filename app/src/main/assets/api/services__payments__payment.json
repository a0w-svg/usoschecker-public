{
  "name": "services/payments/payment",
  "short_name": "payment",
  "description": "<p>\nAn object representing users payment</p>",
  "brief_description": "\nAn object representing users payment",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/payments/#payment",
  "auth_options": {
    "administrative_only": false,
    "token": "required",
