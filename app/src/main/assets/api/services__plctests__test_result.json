{
  "name": "services/plctests/test_result",
  "short_name": "test_result",
  "description": "\nGet result of token issuer's placement test",
  "brief_description": "\nGet placement test's result",
  "ref_url": "https://usosapps.vistula.edu.pl/developers/api/services/plctests/#test_result",
  "auth_options": {
    "administrative_only": false,
    "token": "required",
    "consumer": "required",
    "ssl_required": false,
    "scopes": [
      "placement_tests"
    ]
  },
  "arguments": [
    {
      "name": "test_id",
      "is_required": true,
      "is_deprecated": false,
      "type": "",
      "default_value": null,
      "description": "\nID of placement test"
    },
    {
      "name": "fields",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "user_id|test|value",
      "description": "\n\n            <p><a href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/#fields'>\n            Selector</a> of result fields you are interested in. \n    \n    The selector  may contain any subset of fields, which are\n    described in the <b>returns</b> section.\n</p>\n        "
    },
    {
      "name": "format",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "json",
      "description": "\n<p>Format in which to return values. See <a\n            href='https://usosapps.vistula.edu.pl/developers/api/definitions/datatypes/'>\n            supported output formats</a>.</p>"
    },
    {
      "name": "callback",
      "is_required": false,
      "is_deprecated": false,
      "type": "",
      "default_value": "",
      "description": "\n<p>Required only if you've chosen <b>jsonp</b> as a return format.</p>"
    }
  ],
  "returns": "\n\n                    <p>A dictionary of selected fields and their values.</p>\n                    <p>Available fields:\n                \n    \n    \n    <ul>\n        \n        <li >\n            \n                <p><b>user_id</b> -\n                    ID of a user;</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>test</b> -\n                    Object returned by test method for given ID;</p>\n            \n            \n        </li>\n        \n        <li >\n            \n                <p><b>value</b> -\n                    Number of points, that is result of placement test.</p>\n            \n            \n        </li>\n        \n    </ul>\n</p>",
  "errors": "\n\n    \n    \n    <ul>\n        \n        <li>\n            \n                <p><b>object_not_found</b> - some of the referenced objects do not exist.</p>\n\n                \n\n                \n                    <p>Possible reasons:</p>\n                    <ul>\n                        \n                        <li>\n                            \n                                <p><b>result_not_found</b> -\n                                referenced test result does not exist.</p>\n                            \n                        </li>\n                        \n                    </ul>\n                \n            \n        </li>\n        \n    </ul>\n",
  "result_fields": [
    {
      "name": "user_id",
      "description": "\nID of a user",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "test",
      "description": "\nObject returned by test method for given ID",
      "is_primary": true,
      "is_secondary": false
    },
    {
      "name": "value",
      "description": "\nNumber of points, that is result of placement test",
      "is_primary": true,
      "is_secondary": false
    }
  ],
  "beta": true,
  "deprecated": null,
  "is_internal": false
}
