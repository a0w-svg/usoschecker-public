<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">
        <TextView
            android:id="@+id/progress_text"
            android:accessibilityLiveRegion="polite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="8dp"
            android:text="@string/sync_in_progress"
            android:textColor="@color/app_ink"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <pl.vistula.checker.ui.ScheduleScrollView
                android:id="@+id/main_scroll"
                android:defaultFocusHighlightEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/main_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp" />
            </pl.vistula.checker.ui.ScheduleScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <pl.vistula.checker.ui.SwipeNavigationView
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:minHeight="64dp"
            android:elevation="0dp"
            android:background="@drawable/bg_navigation_pill"
            app:itemIconSize="0dp"
            app:itemIconGravity="start"
            app:itemGravity="center"
            app:iconLabelHorizontalSpacing="0dp"
            app:horizontalItemTextAppearanceActive="@style/PrototypeNavigationText"
            app:horizontalItemTextAppearanceInactive="@style/PrototypeNavigationText"
            app:itemTextAppearanceActiveBoldEnabled="false"
            app:labelFontScalingEnabled="true"
            app:labelMaxLines="2"
            app:itemPaddingTop="4dp"
            app:itemPaddingBottom="4dp"
            app:itemTextAppearanceActive="@style/PrototypeNavigationText"
            app:itemTextAppearanceInactive="@style/PrototypeNavigationText"
            app:itemActiveIndicatorStyle="@style/PrototypeNavigationIndicator"
            app:itemHorizontalTranslationEnabled="false"
            app:itemIconTint="@color/navigation_item_color"
            app:itemTextColor="@color/navigation_text_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
