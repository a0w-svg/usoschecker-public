<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/attendance_course_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_section_divider"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">
    <TextView
        android:id="@+id/attendance_course_name"
        style="@style/Vistula.Text.Subheading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/attendance_course_type"
        style="@style/Vistula.Text.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted" />
    <TextView
        android:id="@+id/attendance_course_badge"
        style="@style/Vistula.Text.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendance_minus"
            style="@style/Widget.Vistula.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:text="@string/attendance_btn_minus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendance_plus"
            style="@style/Widget.Vistula.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="2.2"
            android:text="@string/attendance_btn_plus" />
    </LinearLayout>
</LinearLayout>
