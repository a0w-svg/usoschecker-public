<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_section_divider"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">
    <TextView
        android:id="@+id/payments_account_name"
        style="@style/Vistula.Text.Heading18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/payments_account_faculty"
        style="@style/Vistula.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted"
        android:visibility="gone" />
    <TextView
        android:id="@+id/payments_account_owner"
        style="@style/Vistula.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted"
        android:visibility="gone" />
    <TextView
        android:id="@+id/payments_account_iban"
        style="@style/Vistula.Text.Strong16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/payments_account_swift"
        style="@style/Vistula.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted"
        android:visibility="gone" />
    <TextView
        android:id="@+id/payments_account_balance"
        style="@style/Vistula.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted"
        android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/payments_account_copy"
        style="@style/Widget.Vistula.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/payments_copy_iban" />
</LinearLayout>
