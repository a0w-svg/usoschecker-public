<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/schedule_previous"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/schedule_previous_week"
            android:gravity="center"
            app:icon="@drawable/ic_schedule_previous"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/app_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/schedule_date"
            style="@style/Widget.Vistula.HeaderButton.Date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/schedule_next"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/schedule_next_week"
            android:gravity="center"
            app:icon="@drawable/ic_schedule_next"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/app_ink" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/schedule_more"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/schedule_options"
            android:gravity="center"
            app:icon="@drawable/ic_schedule_more"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/app_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/schedule_week_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <include
        android:id="@+id/schedule_search"
        layout="@layout/view_search_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/schedule_swipe_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="240dp"
        android:orientation="vertical" />
</LinearLayout>
