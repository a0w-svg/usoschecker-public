<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/staff_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/staff_directory_desc"
        android:textColor="@color/app_muted"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/staff_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/staff_search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/staff_search_hint"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:counterEnabled="true"
        app:counterMaxLength="80"
        app:endIconContentDescription="@string/btn_clear_search"
        app:endIconMode="clear_text"
        app:startIconContentDescription="@string/staff_search_button"
        app:startIconDrawable="@drawable/ic_schedule_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/staff_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="80"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textColor="@color/app_ink"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/staff_search_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="52dp"
        android:text="@string/staff_search_button" />

    <TextView
        android:id="@+id/staff_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/staff_search_empty"
        android:textColor="@color/app_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/staff_results_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/app_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/app_outline_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/staff_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/staff_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/staff_search_more"
        android:textColor="@color/app_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
