<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tasks_heading"
            style="@style/Vistula.Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:text="@string/nav_tasks" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tasks_add"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/btn_add_task"
            android:text="@string/tasks_add_symbol" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tasks_more"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/tasks_options"
            android:gravity="center"
            app:icon="@drawable/ic_schedule_more"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/app_ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/tasks_summary"
        style="@style/Vistula.Text.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted" />

    <TextView
        android:id="@+id/tasks_local_note"
        style="@style/Vistula.Text.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/local_data_note"
        android:textColor="@color/app_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tasks_filter_chip"
        style="@style/Widget.Vistula.FilterChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/grades_filter_reset"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tasks_search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/tasks_search_hint"
        android:visibility="gone"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:endIconContentDescription="@string/btn_clear_search"
        app:endIconMode="clear_text">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tasks_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="56dp"
            android:saveEnabled="false"
            android:singleLine="true"
            android:textColor="@color/app_ink"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/tasks_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
