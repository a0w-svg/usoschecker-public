<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Vistula.Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:paddingStart="8dp"
            android:paddingEnd="0dp"
            android:text="@string/nav_tasks" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tasks_add"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/btn_add_task"
            android:text="@string/tasks_add_symbol" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tasks_more"
            style="@style/Widget.Vistula.HeaderButton"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:contentDescription="@string/tasks_options"
            android:gravity="center"
            app:icon="@drawable/ic_schedule_more"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/app_ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/tasks_summary"
        style="@style/Vistula.Text.Note.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tasks_summary_extra"
        style="@style/Vistula.Text.Note.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <TextView
        style="@style/Vistula.Text.Note.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/local_data_note" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tasks_filter_chip"
        style="@style/Widget.Vistula.FilterChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/grades_filter_reset"
        android:visibility="gone" />

    <include
        android:id="@+id/tasks_search_layout"
        layout="@layout/view_search_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tasks_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
