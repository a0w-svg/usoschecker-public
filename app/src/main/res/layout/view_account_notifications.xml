<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/notif_status"
        style="@style/Vistula.Text.BodySmall.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/notif_settings"
        style="@style/Widget.Vistula.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/account_btn_system_notif_settings" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/notif_test"
        style="@style/Widget.Vistula.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/account_btn_send_test_notif" />
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/reminders_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/account_reminder_switch_label"
        android:textColor="@color/app_ink" />

    <LinearLayout
        android:id="@+id/reminders_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
    <TextView
        android:id="@+id/reminders_permission"
        style="@style/Vistula.Text.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/account_reminder_permission_missing"
        android:textColor="@color/app_warning"
        android:visibility="gone" />
    <TextView
        android:id="@+id/reminders_lead_label"
        style="@style/Vistula.Text.Note.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/account_reminder_lead_time_label" />
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/reminders_lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/lead_15"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/account_lead_time_15" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lead_30"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/account_lead_time_30" />

            <com.google.android.material.chip.Chip
                android:id="@+id/lead_45"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/account_lead_time_45" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
    <TextView
        android:id="@+id/notif_channels"
        style="@style/Vistula.Text.Note.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/account_channels_note" />
</LinearLayout>
