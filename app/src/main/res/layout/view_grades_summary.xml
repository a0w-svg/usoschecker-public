<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Vistula.Card"
    android:id="@+id/grades_summary_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Vistula.Text.Strong16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/grades_summary_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grades_summary_help"
            style="@style/Widget.Vistula.HeaderButton.Help"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/grades_summary_help"
            android:text="@string/grades_help_symbol" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/grades_summary_average"
            style="@style/Vistula.Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:paddingStart="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/grades_summary_kind"
                style="@style/Vistula.Text.Micro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/grades_summary_weighted"
                style="@style/Vistula.Text.Strong14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/grades_summary_counts"
                style="@style/Vistula.Text.Caption.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grades_summary_calc"
            style="@style/Widget.Vistula.Button.Compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:text="@string/grades_calc_goals" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grades_summary_share"
            style="@style/Widget.Vistula.Button.Compact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:text="@string/grades_share_report" />
    </LinearLayout>

    <TextView
        style="@style/Vistula.Text.Note.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/grades_card_note" />
</LinearLayout>
