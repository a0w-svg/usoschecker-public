<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_section_divider"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="16dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">
    <TextView
        android:id="@+id/payments_scope_badge"
        style="@style/Vistula.Text.Overline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_warning"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/payments_scope_title"
        style="@style/Vistula.Text.Subheading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/payments_scope_desc"
        style="@style/Vistula.Text.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/payments_scope_note"
        style="@style/Vistula.Text.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="@color/app_muted" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/payments_scope_button"
        style="@style/Widget.Vistula.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />
</LinearLayout>
