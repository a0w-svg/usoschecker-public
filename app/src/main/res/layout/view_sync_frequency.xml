<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/Vistula.Text.Strong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/sync_frequency"
        android:textColor="@color/app_muted" />

    <Spinner
        android:id="@+id/sync_interval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/sync_interval_labels"
        android:minHeight="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sync_interval_save"
        style="@style/Widget.Vistula.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/btn_save_frequency" />
</LinearLayout>
