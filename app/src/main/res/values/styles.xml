<resources>
    <style name="AppThemeBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialAlertDialogTheme">@style/NeutralAlertDialogTheme</item>
        <item name="android:textColorLink">@color/app_ink</item>
        <item name="buttonBarPositiveButtonStyle">@style/NeutralDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NeutralDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralDialogButton</item>
        <item name="fontFamily">sans-serif</item>
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorOnPrimary">@color/app_on_accent</item>
        <item name="colorPrimaryContainer">@color/app_accent_container</item>
        <item name="colorOnPrimaryContainer">@color/app_ink</item>
        <item name="colorSecondary">@color/app_muted</item>
        <item name="colorOnSecondary">@color/app_on_accent</item>
        <item name="colorSecondaryContainer">@color/app_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/app_ink</item>
        <item name="colorSurface">@color/app_background</item>
        <item name="colorSurfaceContainer">@color/app_card</item>
        <item name="colorSurfaceContainerHigh">@color/app_inner_surface</item>
        <item name="colorSurfaceContainerHighest">@color/app_secondary_container</item>
        <item name="colorOutline">@color/app_muted</item>
        <item name="colorOutlineVariant">@color/app_outline_soft</item>
        <item name="colorOnSurface">@color/app_ink</item>
        <item name="colorOnSurfaceVariant">@color/app_muted</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:windowLightStatusBar">@bool/app_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/app_light_system_bars</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_surface_high</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="NeutralAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/NeutralDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/NeutralDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/NeutralDialogButton</item>
    </style>
    <style name="NeutralDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/app_ink</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="PrototypeNavigationText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="PrototypeNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/app_secondary_container</item>
        <item name="android:height">48dp</item>
        <item name="expandedHeight">48dp</item>
        <item name="expandedWidth">wrap_content</item>
        <item name="expandedMarginHorizontal">2dp</item>
        <item name="expandedActiveIndicatorPaddingStart">8dp</item>
        <item name="expandedActiveIndicatorPaddingEnd">8dp</item>
        <item name="shapeAppearance">@style/PrototypePillShape</item>
    </style>
    <style name="PrototypePillShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
